<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LazerTagServerApp</RootNamespace>
    <AssemblyName>LazerTagServerApp</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>AnyCPU;x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazerTagHostLibrary\LazerTagHostLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LazerTagHostLibrary\GameTypes.xml">
      <Link>GameTypes.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>