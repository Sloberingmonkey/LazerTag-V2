#!/bin/sh
set -eu

# Full-screen local TV kiosk for the LazerTag scoreboard.
# Explicit geometry avoids Chromium opening in a smaller default window
# when X is running without a window manager.

xset s off
xset s noblank
xset -dpms

if command -v unclutter >/dev/null 2>&1; then
    unclutter -idle 1 -root &
fi

if command -v chromium >/dev/null 2>&1; then
    BROWSER=chromium
elif command -v chromium-browser >/dev/null 2>&1; then
    BROWSER=chromium-browser
else
    printf 'Chromium is not installed.\n' >&2
    exit 1
fi

OUTPUT="$(xrandr --query | awk '/ connected/{print $1; exit}')"

# Prefer the arena's intended 1280x720 TV mode when the display advertises it.
if xrandr --query | grep -q '1280x720'; then
    MODE="1280x720"
else
    MODE="$(xrandr --query | awk '/\*/{print $1; exit}')"
fi

if [ -n "${OUTPUT}" ] && [ -n "${MODE}" ]; then
    xrandr --output "${OUTPUT}" \
        --primary \
        --mode "${MODE}" \
        --pos 0x0 \
        --rotate normal
fi

GEOMETRY="$(xrandr --current | awk '/current/ {
    for (i = 1; i <= NF; i++) {
        if ($i == "current") {
            width = $(i + 1)
            height = $(i + 3)
            gsub(",", "", width)
            gsub(",", "", height)
            print width "x" height
            exit
        }
    }
}')"

if [ -z "${GEOMETRY}" ]; then
    GEOMETRY="${MODE:-1280x720}"
fi

WIDTH="${GEOMETRY%x*}"
HEIGHT="${GEOMETRY#*x}"

until curl --fail --silent --max-time 3 \
    http://127.0.0.1:5000/healthz >/dev/null; do
    sleep 1
done

PROFILE="${HOME}/.config/lazertag-chromium"
mkdir -p "${PROFILE}"

exec "${BROWSER}" \
    --kiosk \
    --start-fullscreen \
    --window-position=0,0 \
    --window-size="${WIDTH},${HEIGHT}" \
    --force-device-scale-factor=1 \
    --no-first-run \
    --no-default-browser-check \
    --noerrdialogs \
    --disable-session-crashed-bubble \
    --disable-restore-session-state \
    --disable-component-update \
    --disable-features=Translate \
    --password-store=basic \
    --autoplay-policy=no-user-gesture-required \
    --user-data-dir="${PROFILE}" \
    http://127.0.0.1:5000/tv.html
