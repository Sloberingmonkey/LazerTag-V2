# Copy to /etc/lazertag/lazertag.env, replace the placeholder PIN, and keep the
# installed file root:lazertag mode 0640. Do not commit the real PIN.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
DOTNET_EnableDiagnostics=0

# Required in Production. Use a unique value that arena guests cannot guess.
Arena__OperatorPin=REPLACE_WITH_A_UNIQUE_PIN
Arena__OperatorSessionHours=12

# The ESP32 owns .100; the hotspot DHCP range deliberately stops at .99.
Arena__RelayAddress=192.168.4.100:8266
Arena__DataDirectory=/var/lib/lazertag

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
