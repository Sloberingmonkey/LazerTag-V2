{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/LazerTagWebServer.csproj",
        "--configuration", "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Clean Publish Output",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$publish = Join-Path '${workspaceFolder}' 'publish'; if (Test-Path -LiteralPath $publish) { Remove-Item -LiteralPath $publish -Recurse -Force }"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Publish for Pi",
      "command": "dotnet",
      "type": "process",
      "dependsOn": "Clean Publish Output",
      "args": [
        "publish",
        "${workspaceFolder}/LazerTagWebServer.csproj",
        "--configuration", "Release",
        "--runtime", "linux-arm64",
        "--self-contained",
        "--output", "${workspaceFolder}/publish"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Deploy Web Server to Pi",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../deployment/deploy-from-vscode.ps1",
        "-PiTarget",
        "${input:piTarget}"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "piTarget",
      "type": "promptString",
      "description": "Pi SSH target (username@address)",
      "default": "arenaadmin@192.168.1.50"
    }
  ]
}
