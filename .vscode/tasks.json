{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/LazerTagWebServer.csproj",
        "--configuration", "Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Clean Publish Output",
      "command": "powershell",
      "type": "process",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$publish = Join-Path '${workspaceFolder}' 'publish'; if (Test-Path -LiteralPath $publish) { Remove-Item -LiteralPath $publish -Recurse -Force }"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Publish for Pi",
      "command": "dotnet",
      "type": "process",
      "dependsOn": "Clean Publish Output",
      "args": [
        "publish",
        "${workspaceFolder}/LazerTagWebServer.csproj",
        "--configuration", "Release",
        "--runtime", "linux-arm64",
        "--self-contained",
        "--output", "${workspaceFolder}/publish"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Stop Pi Server",
      "type": "shell",
      "dependsOn": "Publish for Pi",
      "command": "ssh",
      "args": [
        "pi@192.168.0.169",
        "sudo systemctl stop lazertag && echo Stopped"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Copy to Pi",
      "type": "shell",
      "dependsOn": "Stop Pi Server",
      "command": "scp",
      "args": [
        "-r",
        "${workspaceFolder}/publish/.",
        "pi@192.168.0.169:/home/pi/lazertag/"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Copy deployment files to Pi",
      "type": "shell",
      "dependsOn": "Copy to Pi",
      "command": "scp",
      "args": [
        "${workspaceFolder}/../deployment/lazertag.service",
        "${workspaceFolder}/../deployment/xinitrc",
        "pi@192.168.0.169:/home/pi/lazertag/"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Deploy to Pi",
      "type": "shell",
      "dependsOn": "Copy deployment files to Pi",
      "command": "ssh",
      "args": [
        "pi@192.168.0.169",
        "chmod +x /home/pi/lazertag/LazerTagWebServer && sudo systemctl restart lazertag && echo Done"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Restart Pi Server",
      "type": "shell",
      "command": "ssh",
      "args": [
        "pi@192.168.0.169",
        "sudo systemctl restart lazertag && echo Restarted"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
